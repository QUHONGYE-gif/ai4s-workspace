# Copy to .env and replace the passwords before first start.
CODER_IMAGE=ghcr.io/coder/coder:2.38.0
CODER_PORT=7080
POSTGRES_PASSWORD=replace-with-a-random-password
CODER_BOOTSTRAP_USERNAME=local-admin
CODER_BOOTSTRAP_EMAIL=local-admin@ai4s.local
CODER_BOOTSTRAP_PASSWORD=replace-with-a-random-password
# Optional existing host proxy, reachable from Docker containers.
AI4S_HTTP_PROXY=
