# Server-only example. Create .env with fresh passwords; never overwrite an existing .env.
CODER_IMAGE=ghcr.io/coder/coder:2.38.0
CODER_PORT=17080
POSTGRES_PASSWORD=replace-with-a-random-password
CODER_BOOTSTRAP_USERNAME=server-admin
CODER_BOOTSTRAP_EMAIL=server-admin@ai4s.local
CODER_BOOTSTRAP_PASSWORD=replace-with-a-random-password
AI4S_HTTP_PROXY=
AI4S_DOCKER_SOCKET=/data1/qhy/docker-ai4s/run/docker.sock

# Set after Tailscale login/Funnel verification; used only with compose.funnel.yaml.
# AI4S_PUBLIC_URL=https://ai4s-coder.example-tailnet.ts.net
