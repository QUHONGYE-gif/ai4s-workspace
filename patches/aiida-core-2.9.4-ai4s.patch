+    assert target.outputs.result.uuid == source_result.uuid
+    records = get_reuse_decision_records(target)
+    assert len(records) == 1
+    assert records[0]['reason']['reason_code'] == 'R01'
+    assert records[0]['final_decision']['action'] == 'reuse'
