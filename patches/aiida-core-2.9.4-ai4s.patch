 class CalcJobNodeCaching(ProcessNodeCaching):
     """Interface to control caching of a node instance."""
+
+    def should_use_cache(self) -> bool:
+        if self._node.base.extras.get('ai4s_context', None):
+            return True
+        if self._node.base.attributes.get('ai4s_identity_unresolved', None):
+            return False
+        return super().should_use_cache()
+
+    @property
+    def is_valid_cache(self) -> bool:
+        if self._node.base.attributes.get('ai4s_identity_unresolved', None):
+            return False
+        return super().is_valid_cache
+
+    @is_valid_cache.setter
+    def is_valid_cache(self, value: bool) -> None:
+        ProcessNodeCaching.is_valid_cache.fset(self, value)
+
+    def _get_same_node(self):
+        import importlib
+        import os
+        context = self._node.base.extras.get('ai4s_context', None)
+        hook = os.environ.get('AIIDA_AI4S_CACHE_DECISION', '')
+        if not context:
+            return super()._get_same_node()
+        # A configured AI4S request must never fall back silently to first-match reuse.
+        if not hook:
+            raise RuntimeError('AI4S request requires AIIDA_AI4S_CACHE_DECISION')
+        module, name = hook.split(':', 1)
+        candidates = [] if self._node.base.attributes.get('ai4s_identity_unresolved', None) else list(
+            self._iter_all_same_nodes(allow_before_store=True))
+        selected = getattr(importlib.import_module(module), name)(self._node, candidates)
+        if selected is not None and all(selected.uuid != candidate.uuid for candidate in candidates):
+            raise ValueError('cache decision selected a node outside native valid candidates')
+        return selected
 
