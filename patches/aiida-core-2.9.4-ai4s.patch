+    source_result = source.outputs.result
+
+    ControlledConsumeCandidateWorkChain.policy = ReusePolicy.ALLOW_REUSE
+    ControlledConsumeCandidateWorkChain.candidates = [_candidate(source_result.uuid)]
+    with enable_caching():
