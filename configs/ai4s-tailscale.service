[Unit]
Description=AI4S Coder HTTPS ingress via Tailscale Funnel
After=network-online.target

[Service]
Type=simple
Slice=ai4s.slice
WorkingDirectory=/data1/qhy/tailscale-ai4s
Environment=TS_NO_LOGS_NO_SUPPORT=true
ExecStart=/data1/qhy/tailscale-ai4s/bin/tailscaled --tun=userspace-networking --state=/data1/qhy/tailscale-ai4s/state/tailscaled.state --statedir=/data1/qhy/tailscale-ai4s/state --socket=/data1/qhy/tailscale-ai4s/run/tailscaled.sock --port=0
Restart=on-failure
RestartSec=5
UMask=0077
MemoryMax=256M
CPUQuota=25%
NoNewPrivileges=true

[Install]
WantedBy=default.target
